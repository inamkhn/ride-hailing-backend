# --- Database (PostgreSQL + PostGIS) ---
# Used by Prisma (prisma/schema.prisma) and the app's connection pool.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ride_hailing?schema=public"

# --- Redis (live driver geo, surge multipliers, stale-ping TTL) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="1d"
# --- JWT access tokens (auth-api-spec §6.1) ---
JWT_KID="key-1"
JWT_ACCESS_TTL_RD="15m"      # rider/driver access TTL
JWT_ACCESS_TTL_ADMIN="10m"   # admin access TTL (shorter)
# --- Refresh tokens, rotating Option B (§6.2) ---
REFRESH_TTL_RD_DAYS=30       # rider/driver rolling expiry
REFRESH_TTL_ADMIN_HOURS=10   # admin non-rolling expiry
# --- OTP / Twilio Verify (§8.1, §8.8) ---
OTP_ALLOWED_COUNTRIES=""     # comma-separated ISO-3166 alpha-2; empty = allow all (target market undecided)
OTP_TEST_BYPASS="false"      # fixed test OTP; hard-refused when NODE_ENV=production
OTP_TEST_CODE=""
# --- Admin TOTP second factor (§4.1) ---
TOTP_ISSUER="RideHailing Backoffice"
# --- Global IP throttling (baseline; per-phone/device limits live in Redis) ---
THROTTLE_TTL_MS=60000        # throttler window in ms
THROTTLE_LIMIT=100           # max requests per IP per window

# --- Twilio Verify (Phone OTP for riders/drivers) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# --- Routing (Mapbox/Google — metered per request, see Routing module cost controls) ---
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# --- Object storage for driver documents (S3-compatible; MinIO locally) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ride-hailing-documents"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"     # true for MinIO; false for most cloud S3
DOCUMENT_UPLOAD_URL_TTL_SECONDS=600   # presigned PUT lifetime
DOCUMENT_VIEW_URL_TTL_SECONDS=300     # presigned GET (review) lifetime
DOCUMENT_MAX_SIZE_BYTES=10485760      # 10 MB cap per document

# --- App ---
PORT=3000
NODE_ENV=development
